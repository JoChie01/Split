# Copy this file to ".env" and fill in your own values. Never commit ".env".
DATABASE_URL=postgres://localhost:5432/split

# Login emails (Resend). Get the key from resend.com. Leave blank to skip email login.
RESEND_API_KEY=
# The sender shown in login emails. The default works only for the account owner's email.
MAIL_FROM="Split <onboarding@resend.dev>"
# Where the web app runs. Login links point here.
APP_URL=http://localhost:5173
